[org.gnome.desktop.interface]
gtk-theme='adw-gtk3'
icon-theme='MoreWaita'

[org.gnome.nautilus.icon-view]
captions = ['size', 'none', 'none']

[org.gnome.nautilus.preferences]
show-create-link=true

[org.gtk.gtk4.settings.file-chooser]
sort-directories-first=true

[org.gtk.settings.file-chooser]
sort-directories-first=true

[io.github.kolunmi.Bazaar]
auto-update=true
auto-update-notifications=true
hide-eol=false

[org.gnome.Ptyxis]
restore-session=false

[org.gnome.shell]
favorite-apps=['helium.desktop', 'io.github.kolunmi.Bazaar.desktop', 'org.gnome.Nautilus.desktop', 'org.gnome.Calendar.desktop', 'org.gnome.TextEditor.desktop', 'org.gnome.Calculator.desktop', 'org.gnome.Settings.desktop']
enabled-extensions=['caffeine@patapon.info', 'legacyschemeautoswitcher@joshimukul29.gmail.com', 'quick-settings-scroll@diskmth.fr', 'weatheroclock@CleoMenezesJr.github.io', 'tiling-assistant@leleat-on-github']

[org.gnome.shell.extensions.caffeine]
enable-fullscreen=false
enable-mpris=false
show-notifications=false

[org.gnome.shell.extensions.tiling-assistant]
single-screen-gap=4
window-gap=4
enable-untile-animations=false
dynamic-keybinding-behavior=0